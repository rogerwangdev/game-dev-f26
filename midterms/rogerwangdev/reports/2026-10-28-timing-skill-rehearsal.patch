@@ -0,0 +1,15 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { Episode } from '../src/episode.js'
+import { loadCore } from '../src/load-core.js'
+const scenario = {id:'one-second-rehearsal', seconds:2.25, quota:50, angle:0, speed:0.1, items:[{kind:'gold_s',x:900,y:600}]}
+const make = () => new Episode(loadCore(),scenario)
+test('one-second wait advances 60 physics frames and expiry stops at 135 frames', () => {
+ const e=make();e.step(0,{type:'wait'});assert.equal(e.observe().frame,60);assert.equal(e.observe().timeLeft,1.25)
+ e.step(0,{type:'wait'});e.step(0,{type:'wait'});assert.equal(e.observe().frame,135);assert.equal(e.outcome().reason,'timer_expired')
+})
+test('last launch offset 59 fires after 59 ticks while 60 is rejected without mutation', () => {
+ const e=make();assert.deepEqual(e.legal_actions()[1],{type:'launch',frame_min:0,frame_max:59})
+ e.step(0,{type:'launch',frame:59});assert.ok(Math.abs(e.observe().claw.angle-59*0.1/60)<1e-10)
+ const invalid=make(),before=invalid.observe();assert.throws(()=>invalid.step(0,{type:'launch',frame:60}));assert.deepEqual(invalid.observe(),before)
+})
